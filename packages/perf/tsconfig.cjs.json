{
  "extends": "../../tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "verbatimModuleSyntax": false,
    "module": "commonjs",
    "moduleResolution": "node10",
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": ["./src/**/*.ts"],
  // Exclude tests from compilation
  "exclude": ["**/tests", "**/*.test.ts", "**/*.spec.ts"]
}

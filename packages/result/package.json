{
  "name": "zu-res",
  "version": "0.0.0",
  "description": "Result wrapper primitives by ZeroUltimax",
  "author": {
    "name": "Antoine Robertson",
    "email": "antoinerobertson92@gmail.com"
  },
  "homepage": "https://github.com/ZeroUltimax/zu-kit",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./fn": {
      "types": "./dist/types/fn/index.d.ts",
      "import": "./dist/esm/fn/index.js",
      "require": "./dist/cjs/fn/index.js"
    },
    "./obj": {
      "types": "./dist/types/obj/index.d.ts",
      "import": "./dist/esm/obj/index.js",
      "require": "./dist/cjs/obj/index.js"
    }
  },
  "scripts": {
    "prepare": "npm run prepare-clean && npm run prepare-esm && npm run prepare-cjs && npm run test",
    "prepare-clean": "rm -rf dist",
    "prepare-esm": "tsc --project tsconfig.esm.json",
    "prepare-cjs": "tsc --project tsconfig.cjs.json",
    "test": "node --test --experimental-test-coverage"
  }
}
